# AI Business Risk — environment variable names (NO values committed).
# Copy to .env and fill in. Contract frozen in docs/architecture.md §6.

# --- Core ---
DATABASE_URL=postgresql+psycopg://abr:abr@localhost:5432/abr
LOG_LEVEL=INFO

# --- LLM (provider-agnostic; GLM is the development default) ---
LLM_PROVIDER=glm
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Alternates (only needed when switching LLM_PROVIDER):
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=

# --- Data sources ---
FRED_API_KEY=
DATA_CACHE_DIR=data/raw

# --- Run budgets (guardrails 8/13) ---
RUN_BUDGET_TOKENS=200000
RUN_TIMEOUT_SECONDS=600

# --- Testing ---
RUN_LIVE_SMOKE=0
